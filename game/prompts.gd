	return PERSONA[lang].format({"after": TAGS_AFTER, "before": TAGS_BEFORE})


static func arrival(lang: String) -> String:
	return PERSONA[lang].get_slice("\n\n", 0) + "\n\n" + ARRIVAL[lang].format({"opening": OPENING[lang]})


